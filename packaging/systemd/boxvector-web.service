[Unit]
Description=boxvector web UI
Documentation=https://github.com/mfr411/boxvector
After=network-online.target bird.service
Wants=network-online.target

[Service]
Type=simple
User=boxvector
Group=boxvector
# bird group: write /etc/bird and talk to /run/bird/bird.ctl
SupplementaryGroups=bird
# Defaults keep existing installs unchanged; the installer writes /etc/boxvector/web.env to narrow them:
#   WEB_LISTEN=127.0.0.1:6969   WEB_ARGS=--allow-from 192.0.2.0/24,203.0.113.5
Environment=WEB_LISTEN=0.0.0.0:6969
EnvironmentFile=-/etc/boxvector/web.env
ExecStart=/usr/bin/boxvector web -c /etc/boxvector.yml \
  --listen ${WEB_LISTEN} $WEB_ARGS --state-dir /var/lib/boxvector/web \
  --tls-cert /etc/boxvector/tls/web.crt --tls-key /etc/boxvector/tls/web.key \
  --auth-file /etc/boxvector/web.users --file-auth
Restart=on-failure
RestartSec=5

StateDirectory=boxvector
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/etc/bird /etc/boxvector /etc/boxvector.yml /var/lib/boxvector -/run/bird -/run/vpp
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
AmbientCapabilities=
MemoryMax=512M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
