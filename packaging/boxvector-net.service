[Unit]
Description=boxvector root network helper
Documentation=https://github.com/mfr411/boxvector
After=network.target
PartOf=boxvector-web.service

[Service]
Type=simple
# Root helper for the web UI's network editing. It accepts only structured, validated operations
# on a socket that root and group boxvector can open; the caller is authenticated (root/sudo) and logged.
ExecStart=/usr/bin/boxvector net-helper --socket /run/boxvector-net.sock
Restart=on-failure
RestartSec=3
StateDirectory=boxvector-net
StateDirectoryMode=0700
UMask=0077
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_CHOWN CAP_SYS_MODULE CAP_DAC_OVERRIDE CAP_FOWNER
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_CHOWN CAP_SYS_MODULE CAP_DAC_OVERRIDE CAP_FOWNER
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run /etc/network /etc/vpp
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
